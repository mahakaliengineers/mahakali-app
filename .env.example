# ============================================================================
# Mahakali Engineers and Developers Pvt. Ltd. — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================================

# ── MySQL Database (Nest Nepal cPanel) ──────────────────────────────────────
DB_HOST=localhost
DB_USER=cpanel_username_dbuser
DB_PASSWORD=your_db_password
DB_NAME=cpanel_username_dbname
DB_PORT=3306

# ── API Server ───────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Session ──────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_secret_string

# ── Object Storage (Google Cloud) ────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-gcs-bucket-id
PRIVATE_OBJECT_DIR=private
PUBLIC_OBJECT_SEARCH_PATHS=public
